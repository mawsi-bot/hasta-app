# Hasta API — local development. Placeholders only; real values live in AWS Secrets Manager.
# Never rename these variables (SPEC §21).
HASTA_ENV=dev
HASTA_PORT=3000
# Docker services address each other by service name (postgres / redis), never localhost.
HASTA_DATABASE_URL=postgresql://hasta:CHANGE_ME@postgres:5432/hasta?schema=public
HASTA_REDIS_URL=redis://redis:6379/0
# Staging/production: set HASTA_SECRETS_ARN and leave the three secrets below unset.
HASTA_SECRETS_ARN=
HASTA_AWS_REGION=ap-southeast-1
HASTA_DEVICE_PEPPER=CHANGE_ME_min_32_chars_random_dev_only_value
HASTA_JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_random_dev_only_value
HASTA_DEVICE_TOKEN_SECRET=CHANGE_ME_min_32_chars_random_dev_only_value
# Feature flags (SPEC §19 — dev column)
HASTA_AUTH_GUEST_ENABLED=true
HASTA_AUTH_GOOGLE_SIGNIN_ENABLED=false
HASTA_AUTH_GOOGLE_LINK_ENABLED=true
HASTA_AUTH_APPLE_LINK_ENABLED=false
HASTA_QUICK_TEST_ACCOUNTS_ENABLED=true
HASTA_DEVICE_COOLDOWN_ENABLED=false
# Sprint 2 (Gmail linking)
HASTA_GOOGLE_CLIENT_ID=
HASTA_GOOGLE_CLIENT_SECRET=
HASTA_GOOGLE_REDIRECT_URI=

# Remote-config fallbacks (SPEC §16 T50): remote config.hasta.<key> > HASTA_RC_<KEY> > code default.
# HASTA_RC_REFRESH_TOKEN_TTL_DAYS=30
