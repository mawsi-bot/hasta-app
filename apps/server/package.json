{
  "name": "@hasta/server",
  "version": "1.0.0",
  "private": true,
  "description": "Hasta v1.0.0 API (NestJS modular monolith)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:rollback": "node scripts/rollback.mjs",
    "seed:test-accounts": "NODE_PATH=./node_modules ts-node -P tsconfig.json ../../tools/scripts/seed-test-accounts.ts",
    "openapi": "ts-node scripts/export-openapi.ts",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:int": "jest --config jest.config.js --selectProjects integration --runInBand",
    "test:cov": "jest --config jest.config.js --coverage --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.693.0",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "7.4.2",
    "@prisma/client": "5.22.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "ioredis": "5.4.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.8",
    "@nestjs/testing": "10.4.15",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.6",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}
